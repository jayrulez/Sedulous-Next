namespace Sedulous.Graphics
{
	/// <summary>
	/// Specify the sort order.
	/// </summary>
	public enum SortMode : uint8
	{
		/// <summary>
		/// No sorting.
		/// </summary>
		None,
		/// <summary>
		/// Front to back sorting.
		/// </summary>
		FrontToBack,
		/// <summary>
		/// Back to Front sorting.
		/// </summary>
		BackToFront
	}
}
